# Copy this file to .env and fill it in. Never commit .env.

# Turn on for local development only.
DEBUG=1

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Supabase → your project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password (URL-encode special characters).
# Leave empty to use a local SQLite file instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Comma-separated hostnames the app is served from (Render's own hostname is added automatically).
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins for any custom domain, e.g. https://steadfast.example.com
CSRF_TRUSTED_ORIGINS=

# Optional: SMTP for password reset emails. Without EMAIL_HOST, reset links are printed to the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Steadfast <no-reply@example.com>
